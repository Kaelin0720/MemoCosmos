# Backend reads process environment; it does not automatically load this file.
# Model settings saved in the UI take precedence. Never use NEXT_PUBLIC_* for keys.
# Data and private config must use separate absolute directories outside the repo.
# Blank values select the operating system application-data defaults.
YIHE_MEMORY_DIR=
YIHE_CONFIG_DIR=
CHAT_MODEL_PROVIDER=openai_compatible
CHAT_MODEL_NAME=
CHAT_MODEL_BASE_URL=
CHAT_MODEL_API_KEY=
RUN_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=12
# Optional IANA timezone; otherwise use this computer's timezone.
YIHE_TIMEZONE=
# Automatic memory is persisted per vault and configured in the settings UI.
# It reuses CHAT_MODEL_*; no local model or embedding is currently required.
